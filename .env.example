# Copy this file to ".env" (same folder) and fill in the values.
# ".env" is git-ignored: never commit real keys.

# TomTom API key (routing + geocoding). Free "Freemium" plan, no credit card:
# https://developer.tomtom.com  -> Dashboard -> Keys
TOMTOM_API_KEY=your-tomtom-api-key-here

# "true" only on your own computer while developing.
DJANGO_DEBUG=true

# Any long random string. Required in production (the host generates one).
DJANGO_SECRET_KEY=change-me-to-a-long-random-string

# Comma-separated host names allowed to serve the app.
# (On Render the public host name is added automatically.)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Open-Meteo (weather) needs no key.
